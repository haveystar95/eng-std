APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Sign-In — accepted OAuth client ids (fill with real values)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# AI collection generation (OpenAI)
OPENAI_API_KEY=
OPENAI_GENERATE_MODEL=gpt-4o
GENERATION_DRIVER=openai

# The server's voice (TTS-2): ElevenLabs, eleven_v3_conversational; voices and the credit price in config/generation.php.
# The key needs text_to_speech and user_read (the account balance for the voice fuse). Off by default: every line is paid.
ELEVENLABS_API_KEY=
SPEECH_ENABLED=false
SPEECH_DRIVER=elevenlabs
# Голоса пакета (ElevenLabs voice id): собеседник и ученик, женский и мужской — все разные; у собеседника — два на
# пол (FIX-4c §1: голос сцены закрепляется при приёме урока, соседние сцены одного пола чередуют 1 и 2).
# Сменить голос: строка здесь → docker compose restart horizon → переозвучка по команде (цена — до покупки).
SPEECH_VOICE_EN_PARTNER_FEMALE=4NejU5DwQjevnR6mh3mb
SPEECH_VOICE_EN_PARTNER_FEMALE_2=QtY3JBOUKEB5xzrRfOKc
SPEECH_VOICE_EN_PARTNER_MALE=EnjklPXGBMNldCJ7jqkE
SPEECH_VOICE_EN_PARTNER_MALE_2=AaOhDHYJ1XLZk74lXhdE
SPEECH_VOICE_EN_LEARNER_MALE=TWutjvRaJqAX89preB4e
SPEECH_VOICE_EN_LEARNER_FEMALE=Nhs7eitvQWFTQBsf0yiT
# Больше этого числа кредитов один запуск озвучки не покупает (задача сцены или plan:speak-backfill).
SPEECH_JOB_CREDITS_CAP=3000

# ngrok tunnel
NGROK_AUTHTOKEN=

# Admin panel — browser origin(s) allowed to call /admin/api/* (comma-separated). Empty = deny all
# cross-origin browser access.
ADMIN_ORIGIN=http://localhost:5173

# QA dev sign-in (POST /api/v1/auth/dev) — password-less, QA accounts only.
# Leave false unless you are running QA on a simulator. Refused outright when APP_ENV=production.
DEV_LOGIN_ENABLED=false

# Plan notifications — APNs (PLAN-UI-3). Leave APNS_KEY_P8 empty = DRY MODE: every letter is written
# to the log and logged in plan_notifications as not_sent. With a key the same queue sends to APNs.
# APNS_KEY_P8 is the .p8 key's contents (\n allowed) or a path to the file inside the container.
# APNS_KEY_P8=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=com.denis.engstd
# sandbox for a debug build from Xcode, production for TestFlight / App Store
# APNS_ENV=sandbox

# The talk with the agent — the sixth stage of a day (наряд CONV-1). The code deals it by default;
# set to false to ship the server before the client that speaks — the day is then dealt the five
# stages of before the наряд and closes on them. Flip it with `docker compose restart horizon`.
# PLAN_CONVERSATION_ENABLED=true

                    },
                    {
                        "step": 3,
                        "kind": "answer",
                        "partner": {
                            "text": "Is the pain sharp, or more of a dull ache?",
                            "translation": "Боль острая или скорее ноющая?",
                            "audio_url": null
                        },
                        "learner": {
                            "text": "The pain is sharp when he bends.",
                            "translation": "Боль острая, когда он наклоняется.",
                            "audio_url": null,
                            "state": "pending",
                            "phrase_ref": "p3",
                            "filler": "sharp"
                        }
                    },
                    {
                        "step": 4,
                        "kind": "answer",
                        "partner": {
                            "text": "Does he have a fever?",
                            "translation": "У него есть температура?",
                            "audio_url": null
                        },
                        "learner": {
                            "text": "No, he doesn't have a fever.",
                            "translation": "Нет, температуры нет.",
                            "audio_url": null,
                            "state": "pending",
                            "phrase_ref": "p4",
                            "filler": null
                        }
                    },
                    {
                        "step": 5,
                        "kind": "answer",
                        "partner": {
                            "text": "It looks like a muscle strain, so he should rest and use a heating pad.",
                            "translation": "Похоже на растяжение мышцы, так что ему нужен покой и грелка.",
                            "audio_url": null
                        },
                        "learner": {
                            "text": "Okay, he will rest at home.",
                            "translation": "Хорошо, он будет отдыхать дома.",
                            "audio_url": null,
                            "state": "pending",
                            "phrase_ref": "p5",
                            "filler": "at home"
                        }
                    },
                    {
                        "step": 3,
                        "kind": "ask",
                        "partner": {
                            "text": "Yes, please tell me the highest reading.",
                            "translation": "Да, пожалуйста, скажите самый высокий показатель.",
                            "audio_url": null
                        },
                        "learner": {
                            "text": "Should I tell you his temperature?",
                            "translation": "Мне сказать вам его температуру?",
                            "audio_url": null,
                            "state": "pending",
                            "phrase_ref": "p3",
                            "filler": "his temperature"

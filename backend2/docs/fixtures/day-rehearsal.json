                    {
                        "step": 1,
                        "kind": "answer",
                        "partner": {
                            "text": "Where does it hurt: his upper back or his lower back?",
                            "translation": "Где болит: вверху спины или в пояснице?",
                            "audio_url": null
                        },
                        "learner": {
                            "text": "It hurts in his lower back.",
                            "translation": "У него болит поясница.",

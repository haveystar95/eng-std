<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Feature tests run against Postgres (pgvector/partial indexes are pg-only),
             in a dedicated database so dev data is left alone. Host/creds come from .env. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="wordtrainer_test"/>
        <env name="DB_URL" value=""/>
        <!-- The QA dev sign-in is ON under test so its happy path is exercised; the tests that
             prove it SHUT flip the gate at runtime (production env / flag off) and assert 404. -->
        <env name="DEV_LOGIN_ENABLED" value="true"/>
        <!--
            NO VENDOR CALLS FROM THE SUITE. Every port in Generation has a `driver === 'fake'`
            branch, and this is what turns them all on at once. It is the FIRST of two measures and
            the weaker one: it can be stepped around by a test that sets the driver back, which is
            legitimate and three files do it on purpose. The second measure is the gate in the
            factories themselves (LiveModelGuard), which refuses under APP_ENV=testing whatever the
            driver says, unless the test opts in out loud.

            Both exist because ONE of them was missing and the suite bought ≈39 gpt-5.4 calls
            (docs/session-handoff.md). The symptom was a slow test.
        -->
        <env name="GENERATION_DRIVER" value="fake"/>
        <env name="TRANSLATION_DRIVER" value="fake"/>
        <env name="PRACTICE_DRIVER" value="fake"/>
        <env name="IMAGE_DRIVER" value="fake"/>
        <!-- ОЗВУЧКА РЕПЛИК: труба выключена и вендор подменён, как у всех соседей выше.
             Пойман живьём: с включённым в .env `SPEECH_ENABLED` весь сьют начал ставить
             SpeakLinesJob (очередь под тестом `sync`), и `LiveModelGuard` отбивал живой
             адаптер прямо внутри генерации дня — 129 упавших тестов. Ровно та причина,
             по которой здесь стоят четыре строки над этой. -->
        <env name="SPEECH_ENABLED" value="false"/>
        <env name="SPEECH_DRIVER" value="fake"/>
        <!-- ПЕЙВОЛЛ ПЛАНА (наряд ACC-1 §2): выключен, как на бою сегодня, — и прибит здесь, чтобы сьют не зависел
             от того, как настроен живой стек: включённый в `.env` он запер бы второй план каждого теста (402) и
             дни 2+ без подписки. Тесты пейволла включают его сами, через `config()`. -->
        <env name="ACCESS_PAYWALL_ENABLED" value="false"/>
        <!-- Судья окна (SESSION-1a): счётчик вызовов на пользователя в сутки — в памяти процесса,
             не в Redis: тест не должен делить кап с живым стеком и с соседним воркером. -->
        <env name="PLAN_SLOT_JUDGE_QUOTA_STORE" value="array"/>
        <!-- ЛОГ СЬЮТА — ВНЕ ДЕРЕВА (наряд ACC-1 §4): канал `testing` пишет в системный temp. В основном дереве
             тысячи строк `testing.*` за прогон уходили в `storage/logs/laravel.log` — лог боя, который пишет
             `wt_app`; после прогона в `storage` дерева не появляется ничего нового. -->
        <env name="LOG_CHANNEL" value="testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>

        {
            "index": 20,
            "speaker": "learner",
            "kind": "said",
            "text_target": "I gave him some paracetamol this morning. What should I do at home?",
            "text_native": null,
            "audio": null,
            "understood": null,
            "phrases_used": [],
            "off_topic": null,
            "created_at": "2026-09-21T22:03:44+00:00"
        },
        {
            "index": 21,
            "speaker": "partner",
            "kind": "agent",
            "text_target": "Give him fluids, let him rest, and check his temperature. Goodbye.",
            "text_native": "Давайте ему пить, пусть он отдыхает и измеряйте температуру. До свидания.",

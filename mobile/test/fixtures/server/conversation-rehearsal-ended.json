            "created_at": "2026-09-21T22:03:17+00:00"
        },
        {
            "index": 13,
            "speaker": "partner",
            "kind": "agent",
            "text_target": "No, an X-ray is not needed for a muscle strain.",
            "text_native": "Нет, при растяжении мышц рентген не нужен.",
            "audio": null,
            "understood": true,
            "phrases_used": [],
            "off_topic": false,
            "created_at": "2026-09-21T22:03:19+00:00"
        },
        {
            "index": 14,
            "speaker": "learner",
            "kind": "said",
            "text_target": "Good morning, doctor. My son has a fever and a sore throat now.",

            "created_at": "2026-09-21T22:03:06+00:00"
        },
        {
            "index": 12,
            "speaker": "learner",
            "kind": "said",
            "text_target": "Do we need an X-ray?",
            "text_native": null,
            "audio": null,
            "understood": null,
            "phrases_used": [],

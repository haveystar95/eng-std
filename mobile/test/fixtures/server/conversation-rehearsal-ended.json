        },
        {
            "index": 19,
            "speaker": "partner",
            "kind": "agent",
            "text_target": "Yes, please tell me the highest reading.",
            "text_native": "Да, пожалуйста, скажите самый высокий показатель.",
            "audio": null,
            "understood": true,
            "phrases_used": [],

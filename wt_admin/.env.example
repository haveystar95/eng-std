# Full URL of the backend admin API. Leave empty to use the built-in mock adapter.
# Examples:
#   VITE_API_BASE=http://localhost:8001/admin/api
#   VITE_API_BASE=https://greedily-thermos-finer.ngrok-free.dev/admin/api
VITE_API_BASE=

# Force the mock adapter even when an API base is set ("1"/"true").
VITE_USE_MOCKS=

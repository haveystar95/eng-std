{
  "name": "wt-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WordTrainer admin panel — read-only data console in the paper design system.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
